{
  "manifest_version": 3,
  "name": "CallGuard — Telegram & WhatsApp call capture",
  "version": "1.2.0",
  "description": "Capture live Telegram and WhatsApp Web calls and send the recording to CallGuard for scam analysis.",
  "homepage_url": "https://sumit2015saurabh-tech.github.io/callguard/",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "activeTab",
    "audioCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*",
    "https://sumit2015saurabh-tech.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CallGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://web.whatsapp.com/*",
        "https://sumit2015saurabh-tech.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
